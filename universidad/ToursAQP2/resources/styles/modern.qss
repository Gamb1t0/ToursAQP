/* ==== ESTILO GENERAL ==== */
QWidget {
    background-color: #2b2b2b;
    color: #f0f0f0;
    font-family: "Segoe UI", "Noto Sans", sans-serif;
    font-size: 13px;
}

/* ==== ETIQUETAS Y TITULOS ==== */
QLabel {
    color: #e0e0e0;
}

QLabel#titulo {
    font-size: 24px;
    font-weight: bold;
    color: #00e676;
}

/* ==== LINE EDIT ==== */
QLineEdit {
    background-color: #3a3a3a;
    color: white;
    border: 1px solid #555;
    border-radius: 6px;
    padding: 5px;
}
QLineEdit:focus {
    border: 1px solid #00e676;
    background-color: #424242;
}

/* ==== BOTONES ==== */
QPushButton {
    background-color: #4CAF50;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 6px 10px;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #66BB6A;
}
QPushButton:pressed {
    background-color: #388E3C;
}

/* Botones secundarios */
QPushButton#btnZoomIn,
QPushButton#btnZoomOut,
QPushButton#btnDFS,
QPushButton#btnBFS,
QPushButton#btnUbicarme {
    background-color: #3c3c3c;
    color: #e0e0e0;
    border: 1px solid #555;
}
QPushButton#btnZoomIn:hover,
QPushButton#btnZoomOut:hover,
QPushButton#btnDFS:hover,
QPushButton#btnBFS:hover,
QPushButton#btnUbicarme:hover {
    border: 1px solid #00e676;
    background-color: #444;
}

/* ==== COMBO BOX ==== */
QComboBox {
    background-color: #3a3a3a;
    color: white;
    border: 1px solid #555;
    border-radius: 5px;
    padding: 4px;
}
QComboBox:hover {
    border-color: #00e676;
}
QComboBox QAbstractItemView {
    background-color: #2b2b2b;
    border: 1px solid #00e676;
    selection-background-color: #00e676;
}

/* ==== LISTAS ==== */
QListWidget {
    background-color: #3a3a3a;
    color: white;
    border: 1px solid #555;
    border-radius: 6px;
}
QListWidget::item {
    padding: 6px;
}
QListWidget::item:selected {
    background-color: #00e676;
    color: black;
}

/* ==== QGRAPHICSVIEW ==== */
QGraphicsView {
    background-color: #1e1e1e;
    border: 1px solid #555;
    border-radius: 8px;
}

/* ==== SCROLLBARS ==== */
QScrollBar:vertical {
    background: #333;
    width: 10px;
    border-radius: 5px;
}
QScrollBar::handle:vertical {
    background: #666;
    min-height: 20px;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
    background: #00e676;
}

/* ==== MESSAGEBOX ==== */
QMessageBox {
    background-color: #2b2b2b;
    color: #f0f0f0;
}
